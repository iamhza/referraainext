{
  // Tell IDE to treat these files as markdown (not TypeScript)
  "files.associations": {
    ".cursorrules": "plaintext",
    "*.md": "markdown"
  },
  
  // Exclude from validation
  "files.exclude": {},
  "search.exclude": {},
  
  // Disable TypeScript checking for these files
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.validate.enable": true,
  
  // Exclude from all language servers
  "javascript.validate.enable": true,
  "[plaintext]": {
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    },
    "editor.suggest.showWords": false
  },
  
  // Don't show errors for documentation files
  "eslint.options": {
    "ignore": [".cursorrules", "ai-dev-tasks/**", "tasks/**", "*.md"]
  },
  
  // Disable validation for .cursorrules specifically
  "eslint.enable": true,
  "typescript.tsserver.experimental.enableProjectDiagnostics": false
}

## 🔐 SCRIPTS & UTILITIES - SECURITY CRITICAL

### **[RULE: SCRIPTS-SECURITY]** Never Commit Secrets

**ABSOLUTE RULES:**
1. ❌ **NEVER hardcode credentials** in any script file
2. ❌ **NEVER commit** database connection strings
3. ❌ **NEVER commit** API keys, tokens, or passwords
4. ✅ **ALWAYS use** `process.env` for sensitive values
5. ✅ **ALWAYS add** risky scripts to `.gitignore`

### Production-Grade Script Structure

**Location: `/scripts/` (organized by purpose)**

```
scripts/
├── dev/                    # Development & debugging utilities
│   ├── debug-clients.js
│   ├── analyze-usage.js
│   └── health-check.js
│
├── migrations/             # One-time data migrations & seeding
│   ├── migrate-*.js
│   ├── seed-*.js
│   └── README.md          # Migration log
│
├── tools/                 # Reusable utilities
│   ├── csv-importer.js
│   └── data-validator.js
│
└── test-data/            # Test fixtures & generators
    ├── *.csv
    └── generate-test-data.js
```

### **[PATTERN: SAFE-SCRIPT]** Template for Secure Scripts

```javascript
// scripts/migrations/seed-example.js

/**
 * @description Seeds example data for testing
 * @requires MONGODB_URI environment variable
 * @usage node scripts/migrations/seed-example.js
 */

const { MongoClient } = require('mongodb');
require('dotenv').config({ path: '.env.local' });

// ✅ CORRECT: Use environment variables
const MONGODB_URI = process.env.MONGODB_URI;

// ✅ CORRECT: Validate before proceeding
if (!MONGODB_URI) {
  console.error('❌ Error: MONGODB_URI not found in environment');
  console.log('Set MONGODB_URI in your .env.local file');
  process.exit(1);
}

async function seedData() {
  const client = new MongoClient(MONGODB_URI);
  
  try {
    await client.connect();
    console.log('✅ Connected to database');
    
    const db = client.db('referradb');
    
    // Your seeding logic here
    const result = await db.collection('test').insertOne({
      name: 'Test',
      createdAt: new Date()
    });
    
    console.log(`✅ Seeded ${result.insertedId}`);
    
  } catch (error) {
    console.error('❌ Seeding failed:', error.message);
    process.exit(1);
  } finally {
    await client.close();
    console.log('✅ Database connection closed');
  }
}

// Only run if executed directly
if (require.main === module) {
  seedData();
}

module.exports = { seedData };
```

### **[ANTI-PATTERN: UNSAFE-SCRIPT]** NEVER Do This

```javascript
// ❌ WRONG: Hardcoded credentials
const uri = "mongodb+srv://username:password@cluster.mongodb.net/db";

// ❌ WRONG: Hardcoded API keys
const STRIPE_SECRET = "sk_live_abc123xyz456";

// ❌ WRONG: Hardcoded passwords
const adminPassword = "SuperSecret123!";

// ❌ WRONG: Production URLs hardcoded
const apiUrl = "https://api.referra.com/v1";
```

### Script Security Checklist

**Before committing ANY script:**
- [ ] No hardcoded credentials or connection strings
- [ ] Uses `process.env` for ALL sensitive values
- [ ] Validates environment variables before use
- [ ] Has clear error messages (no secrets in errors)
- [ ] Includes documentation header
- [ ] Uses `require('dotenv').config()` if needed
- [ ] Has proper try/catch error handling
- [ ] Closes database connections in `finally` block

### **[RULE: GITIGNORE-SCRIPTS]** Protect Risky Scripts

If a script MUST contain test credentials (local dev only):

1. **Add to `.gitignore`:**
   ```gitignore
   # Scripts with hardcoded test credentials (DO NOT COMMIT)
   scripts/migrations/seed-mock-*.js
   scripts/dev/*-with-credentials.js
   ```

2. **Create `.env.example` template:**
   ```bash
   # .env.example
   MONGODB_URI=mongodb://localhost:27017/referradb
   SUPABASE_URL=https://your-project.supabase.co
   SUPABASE_ANON_KEY=your-anon-key
   ```

3. **Document in README:**
   ```markdown
   ## Running Scripts
   
   1. Copy `.env.example` to `.env.local`
   2. Fill in your credentials
   3. Run: `node scripts/migrations/seed-data.js`
   ```

### Script Naming Conventions

```bash
# Development/Debugging
debug-[feature].js          # Debug specific feature
analyze-[metric].js         # Analyze data/metrics
check-[status].js          # Health/status checks

# Migrations
migrate-[description].js    # One-time data migrations
seed-[entity].js           # Seed test data

# Utilities
generate-[output].js       # Generate files/data
import-[source].js         # Import from external sources
export-[format].js         # Export to external formats
```

### Common Script Patterns

#### 1. Database Migration Script
```javascript
const { MongoClient } = require('mongodb');
require('dotenv').config({ path: '.env.local' });

async function migrate() {
  const client = new MongoClient(process.env.MONGODB_URI);
  
  try {
    await client.connect();
    const db = client.db('referradb');
    
    // Migration logic with transaction
    const session = client.startSession();
    await session.withTransaction(async () => {
      // Your migration steps
    });
    
    console.log('✅ Migration completed');
  } catch (error) {
    console.error('❌ Migration failed:', error);
    process.exit(1);
  } finally {
    await client.close();
  }
}

if (require.main === module) migrate();
```

#### 2. CSV Import Script
```javascript
const fs = require('fs');
const csv = require('csv-parser');
const { MongoClient } = require('mongodb');
require('dotenv').config({ path: '.env.local' });

async function importCSV(filePath) {
  const client = new MongoClient(process.env.MONGODB_URI);
  const records = [];
  
  // Read CSV
  await new Promise((resolve, reject) => {
    fs.createReadStream(filePath)
      .pipe(csv())
      .on('data', (row) => records.push(row))
      .on('end', resolve)
      .on('error', reject);
  });
  
  // Insert to database
  try {
    await client.connect();
    const db = client.db('referradb');
    await db.collection('imports').insertMany(records);
    console.log(`✅ Imported ${records.length} records`);
  } finally {
    await client.close();
  }
}

if (require.main === module) {
  const filePath = process.argv[2];
  if (!filePath) {
    console.error('Usage: node import-csv.js <file.csv>');
    process.exit(1);
  }
  importCSV(filePath);
}
```

#### 3. Development Debug Script
```javascript
require('dotenv').config({ path: '.env.local' });
const { MongoClient } = require('mongodb');

async function debugUser(email) {
  const client = new MongoClient(process.env.MONGODB_URI);
  
  try {
    await client.connect();
    const db = client.db('referradb');
    
    const user = await db.collection('users').findOne({ email });
    
    if (!user) {
      console.log(`❌ User not found: ${email}`);
      return;
    }
    
    console.log('✅ User found:');
    console.log(JSON.stringify(user, null, 2));
    
    // Don't log sensitive fields
    delete user.password;
    delete user.apiKey;
    
  } finally {
    await client.close();
  }
}

if (require.main === module) {
  const email = process.argv[2];
  if (!email) {
    console.error('Usage: node debug-user.js <email>');
    process.exit(1);
  }
  debugUser(email);
}
```

### **[RULE: NO-CONSOLE-IN-PRODUCTION]** Logging Rules

```javascript
// ✅ CORRECT: Conditional logging
const isDev = process.env.NODE_ENV !== 'production';
if (isDev) {
  console.log('Debug info:', data);
}

// ✅ CORRECT: Use proper logger
const logger = require('./lib/logger');
logger.info('Operation completed', { userId, action });

// ❌ WRONG: Console logs in production code
console.log('User data:', user); // Will be in production logs!

// ❌ WRONG: Logging sensitive data
console.log('Password:', password); // NEVER!
console.log('API Key:', apiKey); // NEVER!
```


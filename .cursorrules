## 🏗️ Architecture Patterns

### Database (MongoDB)

**[RULE: DATA-ISOLATION-REQUIRED] ALWAYS implement Organization Data Isolation:**

**MongoDB Collection Structure:**
```javascript
// Every document MUST have these fields
{
  _id: ObjectId,
  organizationId: ObjectId,  // REQUIRED for data isolation
  createdAt: Date,
  updatedAt: Date,
  createdBy: ObjectId,
  deletedAt: Date | null  // Soft deletes
}

// Example: clients collection
db.clients.insertOne({
  _id: new ObjectId(),
  organizationId: new ObjectId(profile.organizationId),
  firstName: "John",
  lastName: "Doe",
  createdBy: new ObjectId(session.user.id),
  createdAt: new Date(),
  updatedAt: new Date(),
  deletedAt: null
});
```

**MongoDB Indexes for Performance:**
```javascript
// ALWAYS create compound index for organization isolation
db.clients.createIndex({ organizationId: 1, deletedAt: 1 });
db.clients.createIndex({ organizationId: 1, createdAt: -1 });
```

**MongoDB Best Practices:**
- Use ObjectId for all _id fields
- Add indexes on frequently queried fields (organizationId, createdAt, etc.)
- Use Date objects for all timestamps (createdAt, updatedAt, deletedAt)
- Soft delete with `deletedAt` instead of hard deletes
- Use nested objects for flexible metadata
- Always add comments to migration scripts
- Use aggregation pipelines for complex queries

**Data Isolation Query Patterns:**
```javascript
// Read access (organization members) - ALWAYS filter by organizationId
const clients = await db.collection('clients').find({
  organizationId: profile.organizationId,
  deletedAt: { $exists: false }  // Exclude soft-deleted
}).toArray();

// Write access (specific roles only) - check role in API route
if (!['case_manager', 'supervisor', 'org_admin'].includes(profile.role)) {
  throw new Error('Insufficient permissions');
}
await db.collection('clients').insertOne({
  organizationId: profile.organizationId,
  createdBy: new ObjectId(session.user.id),
  // ... other fields
});

// Update own records only
await db.collection('clients').updateOne(
  { 
    _id: new ObjectId(clientId),
    organizationId: profile.organizationId,
    createdBy: new ObjectId(session.user.id)  // Only own records
  },
  { $set: { ...updates, updatedAt: new Date() } }
);
```

### API Routes

**[PATTERN: API-ROUTE] Standard API Route Pattern:**
```typescript
// src/app/api/[resource]/route.ts
import { getServerSession } from 'next-auth';
import { authOptions } from '@/lib/auth/auth-minimal';
import { connectToDatabase } from '@/lib/mongodb/client';
import { NextResponse } from 'next/server';
import { z } from 'zod';
import { ObjectId } from 'mongodb';

// Define request schema
const requestSchema = z.object({
  field: z.string().min(1),
  // ... more fields
});

export async function POST(request: Request) {
  try {
    // 1. Verify authentication
    const session = await getServerSession(authOptions);
    if (!session?.user) {
      return NextResponse.json(
        { error: 'Unauthorized' }, 
        { status: 401 }
      );
    }

    // 2. Connect to database
    const { db } = await connectToDatabase();

    // 3. Get user profile and organization
    const profile = await db.collection('user_profiles').findOne({
      userId: new ObjectId(session.user.id),
    });

    if (!profile) {
      return NextResponse.json(
        { error: 'Profile not found' }, 
        { status: 404 }
      );
    }

    // 4. Parse and validate request body
    const body = await request.json();
    const validated = requestSchema.parse(body);

    // 5. Check role-based permissions (if needed)
    if (!['case_manager', 'supervisor', 'org_admin'].includes(profile.role)) {
      return NextResponse.json(
        { error: 'Insufficient permissions' }, 
        { status: 403 }
      );
    }

    // 6. Perform database operation
    const result = await db.collection('resources').insertOne({
      ...validated,
      organizationId: profile.organizationId,
      createdBy: new ObjectId(session.user.id),
      createdAt: new Date(),
      updatedAt: new Date(),
    });

    const inserted = await db.collection('resources').findOne({
      _id: result.insertedId,
    });

    // 7. Return success response
    return NextResponse.json(inserted, { status: 201 });

  } catch (error) {
    // 8. Handle errors appropriately
    console.error('API Error:', error);
    
    if (error instanceof z.ZodError) {
      return NextResponse.json(
        { error: 'Invalid request data', details: error.errors }, 
        { status: 400 }
      );
    }

    return NextResponse.json(
      { error: 'Internal server error' }, 
      { status: 500 }
    );
  }
}

// GET pattern with query params
export async function GET(request: Request) {
  try {
    const session = await getServerSession(authOptions);
    if (!session?.user) {
      return NextResponse.json({ error: 'Unauthorized' }, { status: 401 });
    }

    const { db } = await connectToDatabase();
    const { searchParams } = new URL(request.url);

    // Get user's organization
    const profile = await db.collection('user_profiles').findOne({
      userId: new ObjectId(session.user.id),
    });

    if (!profile) {
      return NextResponse.json({ error: 'Profile not found' }, { status: 404 });
    }

    // Build query with filters
    const filter: any = { 
      organizationId: profile.organizationId,
      deletedAt: { $exists: false },
    };

    // Apply filters from query params
    const status = searchParams.get('status');
    if (status) {
      filter.status = status;
    }

    const data = await db.collection('resources')
      .find(filter)
      .sort({ createdAt: -1 })
      .toArray();

    return NextResponse.json(data);
  } catch (error) {
    console.error('API Error:', error);
    return NextResponse.json(
      { error: 'Internal server error' }, 
      { status: 500 }
    );
  }
}
```

**API Route Checklist:**
- [ ] Authentication check (reject if not logged in)
- [ ] Get user profile and organization_id
- [ ] Role-based permission check (if needed)
- [ ] Input validation with Zod schemas
- [ ] Proper error handling and logging
- [ ] Appropriate HTTP status codes
- [ ] MongoDB queries filter by organizationId (enforce data isolation)
- [ ] Rate limiting considerations for public endpoints

### Server Actions

**[PATTERN: SERVER-ACTION] For mutations, prefer Server Actions over API routes:**
```typescript
// src/lib/actions/client-actions.ts
'use server';

import { getServerSession } from 'next-auth';
import { authOptions } from '@/lib/auth/auth-minimal';
import { connectToDatabase } from '@/lib/mongodb/client';
import { revalidatePath } from 'next/cache';
import { z } from 'zod';
import { ObjectId } from 'mongodb';

const createClientSchema = z.object({
  first_name: z.string().min(1),
  last_name: z.string().min(1),
  email: z.string().email().optional(),
  phone: z.string().optional(),
});

type ActionResult<T> = 
  | { success: true; data: T }
  | { success: false; error: string };

export async function createClient(
  formData: FormData
): Promise<ActionResult<{ id: string }>> {
  try {
    // Auth check
    const session = await getServerSession(authOptions);
    if (!session?.user) {
      return { success: false, error: 'Unauthorized' };
    }

    // Connect to database
    const { db } = await connectToDatabase();

    // Get profile
    const profile = await db.collection('user_profiles').findOne({
      userId: new ObjectId(session.user.id),
    });

    if (!profile) {
      return { success: false, error: 'Profile not found' };
    }

    // Validate input
    const rawData = {
      first_name: formData.get('first_name'),
      last_name: formData.get('last_name'),
      email: formData.get('email'),
      phone: formData.get('phone'),
    };

    const validated = createClientSchema.parse(rawData);

    // Insert
    const result = await db.collection('clients').insertOne({
      ...validated,
      organizationId: profile.organizationId,
      createdBy: new ObjectId(session.user.id),
      createdAt: new Date(),
      updatedAt: new Date(),
    });

    // Revalidate relevant paths
    revalidatePath('/case-manager/clients');
    revalidatePath('/case-manager');

    return { success: true, data: { id: result.insertedId.toString() } };
  } catch (error) {
    console.error('Create client error:', error);
    return { 
      success: false, 
      error: error instanceof Error ? error.message : 'Failed to create client' 
    };
  }
}
```

### React Components

**Server Component (default):**
```typescript
// src/components/clients/ClientList.tsx
import { getServerSession } from 'next-auth';
import { authOptions } from '@/lib/auth/auth-minimal';
import { connectToDatabase } from '@/lib/mongodb/client';
import { ClientCard } from './ClientCard';
import { ObjectId } from 'mongodb';

export async function ClientList() {
  const session = await getServerSession(authOptions);
  if (!session?.user) return null;

  const { db } = await connectToDatabase();
  
  // Get user's organization
  const profile = await db.collection('user_profiles').findOne({
    userId: new ObjectId(session.user.id),
  });

  if (!profile) return null;

  const clients = await db.collection('clients')
    .find({ 
      organizationId: profile.organizationId,
      deletedAt: { $exists: false },
    })
    .sort({ createdAt: -1 })
    .toArray();

  if (!clients?.length) {
    return (
      <div className="text-center py-12 text-muted-foreground">
        No clients found. Create your first client to get started.
      </div>
    );
  }

  return (
    <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {clients.map((client) => (
        <ClientCard key={client._id.toString()} client={client} />
      ))}
    </div>
  );
}
```

**Client Component (when needed):**
```typescript
// src/components/clients/AddClientModal.tsx
'use client';

import { useState } from 'react';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import { Dialog, DialogContent, DialogHeader, DialogTitle } from '@/components/ui/dialog';
import { toast } from 'sonner';
import { createClient } from '@/lib/actions/client-actions';

interface AddClientModalProps {
  open: boolean;
  onOpenChange: (open: boolean) => void;
}

export function AddClientModal({ open, onOpenChange }: AddClientModalProps) {
  const [loading, setLoading] = useState(false);

  async function handleSubmit(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault();
    setLoading(true);

    try {
      const formData = new FormData(event.currentTarget);
      const result = await createClient(formData);

      if (!result.success) {
        toast.error(result.error);
        return;
      }

      toast.success('Client created successfully');
      onOpenChange(false);
      event.currentTarget.reset();
    } catch (error) {
      toast.error('Failed to create client');
      console.error(error);
    } finally {
      setLoading(false);
    }
  }

  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent className="sm:max-w-[500px]">
        <DialogHeader>
          <DialogTitle>Add New Client</DialogTitle>
        </DialogHeader>
        
        <form onSubmit={handleSubmit} className="space-y-4">
          <div className="grid grid-cols-2 gap-4">
            <div className="space-y-2">
              <Label htmlFor="first_name">First Name *</Label>
              <Input
                id="first_name"
                name="first_name"
                required
                disabled={loading}
              />
            </div>
            
            <div className="space-y-2">
              <Label htmlFor="last_name">Last Name *</Label>
              <Input
                id="last_name"
                name="last_name"
                required
                disabled={loading}
              />
            </div>
          </div>

          <div className="space-y-2">
            <Label htmlFor="email">Email</Label>
            <Input
              id="email"
              name="email"
              type="email"
              disabled={loading}
            />
          </div>

          <div className="flex justify-end gap-2">
            <Button
              type="button"
              variant="outline"
              onClick={() => onOpenChange(false)}
              disabled={loading}
            >
              Cancel
            </Button>
            <Button type="submit" disabled={loading}>
              {loading ? 'Creating...' : 'Create Client'}
            </Button>
          </div>
        </form>
      </DialogContent>
    </Dialog>
  );
}
```

**Component Best Practices:**
- Use Server Components by default (no 'use client')
- Only add 'use client' when you need: hooks, event handlers, browser APIs, context
- Always implement loading states
- Always implement error states
- Always implement empty states
- Use optimistic updates for better UX
- Implement proper form validation
- Use toast notifications for user feedback
- Make components responsive (mobile-first)
- Use semantic HTML
- Add proper ARIA labels for accessibility


## 🚫 Common Pitfalls to AVOID

### ❌ DON'T Do These

```typescript
// ❌ Don't use 'any'
function process(data: any) { }

// ❌ Don't skip authentication checks
export async function GET(request: Request) {
  // No auth check - SECURITY VULNERABILITY
  const data = await db.collection('clients').find({}).toArray();
}

// ❌ Don't skip organization filtering
const clients = await db.collection('clients').find({}).toArray();  // NEVER! Missing organizationId filter

// ❌ Don't commit sensitive data
const API_KEY = 'sk_live_abc123';  // Use env vars!

// ❌ Don't use inline styles
<div style={{ color: 'red' }}>  // Use Tailwind classes

// ❌ Don't hard-code URLs
fetch('https://api.example.com/data');  // Use env vars

// ❌ Don't ignore errors
try {
  await dangerousOperation();
} catch (e) {
  // Empty catch - BAD!
}

// ❌ Don't use var
var count = 0;  // Use const/let

// ❌ Don't mutate props
function Component({ data }) {
  data.value = 'new';  // NO! Props are immutable
}

// ❌ Don't use nested ternaries
const value = a ? b : c ? d : e ? f : g;  // Unreadable

// ❌ Don't create massive components
export function Dashboard() {
  // 1000 lines of code
  // Split into smaller components!
}

// ❌ Don't fetch in loops
for (const client of clients) {
  const data = await fetchClientData(client.id);  // N+1 query!
}
// Use: const data = await fetchAllClientData(clients.map(c => c.id));

// ❌ Don't forget loading states
<Button onClick={handleSubmit}>Submit</Button>  // No loading state

// ❌ Don't forget empty states
{items.map(item => <ItemCard key={item.id} item={item} />)}
// What if items is empty?

// ❌ Don't use magic numbers
if (status === 3) { }  // What is 3?
// Use: if (status === ReferralStatus.ACCEPTED) { }
```

### ✅ DO These Instead

```typescript
// ✅ Use proper types
function process(data: ClientData) { }

// ✅ Always check authentication
export async function GET(request: Request) {
  const { data: { user } } = await supabase.auth.getUser();
  if (!user) {
    return NextResponse.json({ error: 'Unauthorized' }, { status: 401 });
  }
}

// ✅ Always filter by organizationId
const clients = await db.collection('clients').find({ organizationId: profile.organizationId }).toArray();

// ✅ Use environment variables
const apiKey = process.env.API_KEY;

// ✅ Use Tailwind classes
<div className="text-red-600">

// ✅ Use environment variables for URLs
const apiUrl = process.env.NEXT_PUBLIC_API_URL;

// ✅ Handle errors properly
try {
  await dangerousOperation();
} catch (error) {
  console.error('Operation failed:', error);
  toast.error('Something went wrong');
}

// ✅ Use const/let
const count = 0;
let mutableValue = 1;

// ✅ Never mutate props
function Component({ data }) {
  const [localData, setLocalData] = useState(data);
  setLocalData({ ...localData, value: 'new' });
}

// ✅ Extract complex logic
const getValue = () => {
  if (a) return b;
  if (c) return d;
  if (e) return f;
  return g;
};
const value = getValue();

// ✅ Split large components
export function Dashboard() {
  return (
    <>
      <DashboardHeader />
      <DashboardStats />
      <DashboardCharts />
      <DashboardActivity />
    </>
  );
}

// ✅ Batch database queries
const clientIds = clients.map(c => c._id);
const allData = await db.collection('client_data')
  .find({ clientId: { $in: clientIds } })
  .toArray();

// ✅ Always implement loading states
const [loading, setLoading] = useState(false);
<Button onClick={handleSubmit} disabled={loading}>
  {loading ? 'Submitting...' : 'Submit'}
</Button>

// ✅ Always implement empty states
{items.length === 0 ? (
  <EmptyState />
) : (
  items.map(item => <ItemCard key={item.id} item={item} />)
)}

// ✅ Use named constants
const REFERRAL_STATUS_ACCEPTED = 3;
if (status === REFERRAL_STATUS_ACCEPTED) { }
// Better: Use enums or const objects
```


## 🎯 Performance Optimization

### Database Query Optimization

```typescript
// ❌ Bad: N+1 queries
for (const referral of referrals) {
  const provider = await db.collection('providers')
    .findOne({ _id: referral.providerId });
}

// ✅ Good: Single query with aggregation
const referrals = await db.collection('referrals').aggregate([
  {
    $lookup: {
      from: 'providers',
      localField: 'providerId',
      foreignField: '_id',
      as: 'provider'
    }
  },
  { $unwind: '$provider' }
]).toArray();
```

### React Performance

```typescript
// ✅ Use React.memo for expensive components
export const ClientCard = React.memo(({ client }: { client: Client }) => {
  return <Card>...</Card>;
});

// ✅ Use useCallback for event handlers passed to children
const handleUpdate = useCallback((id: string) => {
  // Handler logic
}, []);

// ✅ Use useMemo for expensive calculations
const sortedClients = useMemo(() => {
  return clients.sort((a, b) => a.name.localeCompare(b.name));
}, [clients]);

// ✅ Lazy load heavy components
const HeavyChart = dynamic(() => import('./HeavyChart'), {
  loading: () => <Skeleton />,
});
```

### Image Optimization

```typescript
// ✅ Use Next.js Image component
import Image from 'next/image';

<Image
  src="/avatar.jpg"
  alt="User avatar"
  width={48}
  height={48}
  className="rounded-full"
/>

// ✅ Use placeholder for loading
<Image
  src="/avatar.jpg"
  alt="User avatar"
  width={48}
  height={48}
  placeholder="blur"
  blurDataURL="data:image/..."
/>
```

